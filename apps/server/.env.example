# YieldIQ Server Environment Configuration

# Servidor & Ambiente
NODE_ENV=development
PORT=8000
CORS_ORIGIN=*
LOG_LEVEL=info

# Banco de Dados & Autenticação (Supabase)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sua-service-role-key
SUPABASE_ANON_KEY=sua-anon-key
JWT_SECRET=seu-jwt-secret-super-seguro

# Provedores de Dados de Fundos Listados (B3, CVM FNet, Yahoo Finance)
B3_BASE_URL=https://sistemaswebb3-listados.b3.com.br
B3_REFERER_URL=https://www.b3.com.br/
B3_CACHE_TTL_MS=3600000

FNET_BASE_URL=https://fnet.bmfbovespa.com.br
FNET_REFERER_URL=https://fnet.bmfbovespa.com.br/fnet/publico/abrirGerenciadorDocumentosCVM
FNET_CACHE_TTL_MS=300000

YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
YAHOO_CACHE_TTL_MS=60000

TREASURY_BASE_URL=https://www.tesourodireto.com.br
TREASURY_CACHE_TTL_MS=600000

HTTP_DEFAULT_TIMEOUT_MS=15000

# WhatsApp & Alertas Automatizados
WHATSAPP_AUTO_START=true

# Web Push Notifications (Opcional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
